# Settings for rubrik-probe, rubrik-sample and rubrik-mask.
#   cp .env.example .env    then fill it in. .env is never committed.
# The process environment wins over this file.

# The service account's JSON file, as RSC downloaded it. Keep it outside
# this repository (it holds the secret).
RUBRIK_SERVICE_ACCOUNT=~/secrets/rubrik/blt-reader.json

# Only behind a proxy that re-signs TLS: its CA certificate.
RUBRIK_CA_BUNDLE=

# Your own secret for rubrik-mask, at least 16 characters. Keep it the
# same from capture to capture (pseudonyms stay stable) and never share
# it - with it, a masked name can be checked against a guess. Make one:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
RUBRIK_MASK_SALT=

# Where captures go (raw: real names, git-ignored) and their masked
# copies (safe to commit or share).
RUBRIK_SAMPLES_DIR=samples/raw
RUBRIK_MASKED_DIR=samples/masked
